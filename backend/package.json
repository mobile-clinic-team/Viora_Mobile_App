{
  "name": "viora",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1",
    "lint": "eslint apps libs database eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "api:start": "node --experimental-strip-types apps/api/src/main.ts",
    "db:migrate": "node --experimental-strip-types database/migrate.ts",
    "boundaries": "node tools/validate-boundaries.mjs",
    "quality": "npm run lint && npm run typecheck && npm run build && npm test && npm run boundaries",
    "nx:projects": "nx show projects --json"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "nx": "23.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
